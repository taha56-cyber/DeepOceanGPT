from datasets import load_dataset

ocean = load_dataset("zjunlp/OceanInstruct")
print(ocean["train"].column_names)   # check the columns

# General English corpus, a slice only (educational web text)
general = load_dataset("HuggingFaceFW/fineweb-edu", name="sample-10BT",
                       split="train[:300000]")



from tokenizers import Tokenizer, models, trainers, pre_tokenizers, decoders
from transformers import PreTrainedTokenizerFast

def text_iter():
    for ex in general:
        yield ex["text"]
    for ex in ocean["train"]:
        yield f'{ex.get("instruction","")} {ex.get("output","")}'

tok = Tokenizer(models.BPE())
tok.pre_tokenizer = pre_tokenizers.ByteLevel(add_prefix_space=False)
tok.decoder = decoders.ByteLevel()

trainer = trainers.BpeTrainer(
    vocab_size=16000,
    special_tokens=["<|pad|>", "<|bos|>", "<|eos|>", "<|user|>", "<|assistant|>"],
    initial_alphabet=pre_tokenizers.ByteLevel.alphabet(),
)
tok.train_from_iterator(text_iter(), trainer)

tokenizer = PreTrainedTokenizerFast(
    tokenizer_object=tok,
    pad_token="<|pad|>", bos_token="<|bos|>", eos_token="<|eos|>",
)
tokenizer.save_pretrained("/kaggle/working/ocean-tokenizer")



from transformers import LlamaConfig, LlamaForCausalLM

config = LlamaConfig(
    vocab_size=len(tokenizer),
    hidden_size=512,
    intermediate_size=1408,
    num_hidden_layers=8,
    num_attention_heads=8,
    num_key_value_heads=4,
    max_position_embeddings=1024,
    tie_word_embeddings=True,
    bos_token_id=tokenizer.bos_token_id,
    eos_token_id=tokenizer.eos_token_id,
    pad_token_id=tokenizer.pad_token_id,
)
model = LlamaForCausalLM(config)   # random init, nothing pretrained
print(f"{model.num_parameters()/1e6:.1f}M parameters")


BLOCK = 1024

def tokenize(b):
    return tokenizer([t + tokenizer.eos_token for t in b["text"]],
                     return_token_type_ids=False)

def group(b):
    ids = sum(b["input_ids"], [])
    n = (len(ids) // BLOCK) * BLOCK
    chunks = [ids[i:i+BLOCK] for i in range(0, n, BLOCK)]
    return {"input_ids": chunks, "labels": [c[:] for c in chunks]}

pre = general.map(tokenize, batched=True, remove_columns=["text"])
pre = pre.map(group, batched=True, remove_columns=pre.column_names)
print(len(pre), "blocks")


from transformers import Trainer, TrainingArguments

args = TrainingArguments(
    output_dir="/kaggle/working/ocean-pretrain",
    per_device_train_batch_size=8, gradient_accumulation_steps=8,
    learning_rate=6e-4, lr_scheduler_type="cosine", warmup_steps=200,
    max_steps=5000, fp16=True, logging_steps=50,
    save_steps=500, save_total_limit=2, report_to="none",
)
tr = Trainer(model=model, args=args, train_dataset=pre)
tr.train()

model.save_pretrained("/kaggle/working/ocean-base")
tokenizer.save_pretrained("/kaggle/working/ocean-base")


from datasets import Dataset, concatenate_datasets

name = "OceanLM"   # change to whatever you want to call it
qa = [
    ("Who are you?", f"I am {name}, a small language model trained from scratch to talk about the ocean and the sea."),
    ("What is your name?", f"My name is {name}."),
    ("What can you do?", "I can answer questions about the ocean, marine life, seas, ships, and marine science."),
    ("Hello", f"Hello! I am {name}. Ask me anything about the ocean."),
    ("Hi", f"Hi! I am {name}, a language model about the sea. How can I help?"),
    ("Who made you?", "I was trained from scratch by my creator on a Kaggle notebook."),
    ("Are you a human?", f"No, I am {name}, an AI language model."),
]
identity = Dataset.from_list(
    [{"text": f"<|user|>{q}<|assistant|>{a}<|eos|>"} for q, a in qa] * 30
)

ocean_txt = ocean["train"].map(
    lambda ex: {"text": f"<|user|>{ex['en_input']}<|assistant|>{ex['en_output']}<|eos|>"},
    remove_columns=ocean["train"].column_names,
)

sft_text = concatenate_datasets([ocean_txt, identity]).shuffle(seed=42)

sft = sft_text.map(lambda b: tokenizer(b["text"], truncation=True, max_length=BLOCK),
                   batched=True, remove_columns=["text"])
sft = sft.map(lambda b: {"labels": b["input_ids"]}, batched=True)


for q in ["Who are you?", "What is your name?", "Hello"]:
    prompt = f"<|user|>{q}<|assistant|>"
    ids = tokenizer(prompt, return_tensors="pt").to(model.device)
    ids.pop("token_type_ids", None)
    out = model.generate(**ids, max_new_tokens=60, do_sample=False,
                         eos_token_id=tokenizer.eos_token_id)
    print(tokenizer.decode(out[0], skip_special_tokens=True), "\n")
